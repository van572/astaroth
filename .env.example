# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ControlQR (opcionales - también configurables desde Panel de Administración)
# Ruta de persistencia para SQLite (ej. /var/data si usas Render Persistent Disk)
DATA_DIR=""
# Clave secreta para cifrar credenciales SMTP en SQLite (AES-256-GCM)
SMTP_ENCRYPTION_KEY=""
# PIN inicial para primer arranque (por defecto: 1234)
INITIAL_ADMIN_PIN=""
# Credenciales SMTP opcionales por entorno
ADMIN_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Base de datos externa secreta (opcional - Supabase / PostgreSQL)
SUPABASE_URL=""
SUPABASE_KEY=""
DATABASE_URL=""
